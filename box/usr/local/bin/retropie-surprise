#!/usr/bin/env python3
"""EmulationStation "Surprise Me" tile: picks a random game you haven't played yet.

Pool: every game shown in the game lists (not hidden) that has artwork, on consoles with games.
Consoles you play most (Play Stats) come up more often; games already played are left out.
Up / down picks a console (or Any console). A plays it, X shows another, B goes back.
The choice is written to /tmp/retropie-surprise-choice ("system<TAB>rom") for the tile's script.
"""
import collections, json, math, os, random, re, sys, xml.etree.ElementTree as ET
sys.path.insert(0, '/usr/local/lib/retropie')
import retropie_ui as ui
import pygame

ROMS = os.path.expanduser('~/RetroPie/roms')
PLAYLOG = os.path.expanduser('~/.local/share/retropie-playtime.jsonl')
CHOICE = '/tmp/retropie-surprise-choice'
SKIP = {'retropie', 'searchgames', 'surprise', 'kodi', 'ports', 'mame-libretro'}
NAMES = {'arcade': 'Arcade', 'snes': 'SNES', 'nes': 'NES', 'megadrive': 'Mega Drive', 'n64': 'Nintendo 64',
         'psx': 'PlayStation', 'ps2': 'PlayStation 2', 'psp': 'PSP', 'gc': 'GameCube', 'wii': 'Wii', 'wiiu': 'Wii U',
         'nds': 'Nintendo DS', 'dreamcast': 'Dreamcast', 'gba': 'Game Boy Advance', 'gb': 'Game Boy',
         'gbc': 'Game Boy Color', 'xbox': 'Xbox', 'mastersystem': 'Master System', 'gamegear': 'Game Gear'}

def load():
    played, by_sys = set(), collections.Counter()
    try:
        for l in open(PLAYLOG):
            s = json.loads(l); played.add(os.path.normpath(s['rom'])); by_sys[s['system']] += s['end'] - s['start']
    except (OSError, ValueError):
        pass
    games = collections.defaultdict(list)
    for d in sorted(os.listdir(ROMS)):
        gl = f'{ROMS}/{d}/gamelist.xml'
        if d in SKIP or os.path.islink(f'{ROMS}/{d}') or not os.path.exists(gl): continue
        try:
            root = ET.parse(gl).getroot()
        except ET.ParseError:
            continue
        for g in root.iter('game'):
            p = g.findtext('path') or ''
            p = os.path.normpath(p if p.startswith('/') else f'{ROMS}/{d}/{p}')
            img = g.findtext('image') or ''
            if (g.findtext('hidden') == 'true' or p in played or not img or not os.path.exists(p)
                    or re.search(r'bios|device|system', g.findtext('genre') or '', re.I) or re.search(r'\bbios\b', p, re.I)
                    # good surprises only: games with a description, not Japanese-only versions
                    or not (g.findtext('desc') or '').strip()
                    or re.search(r'\((J|Japan|JP)\)|\(Japan,', (g.findtext('name') or '') + os.path.basename(p))):
                continue
            if img.startswith('./'): img = f'{ROMS}/{d}/{img[2:]}'
            games[d].append({'system': d, 'rom': p, 'name': g.findtext('name') or os.path.basename(p), 'image': img,
                             'desc': (g.findtext('desc') or '').strip(), 'genre': g.findtext('genre') or '',
                             'year': (g.findtext('releasedate') or '')[:4], 'players': g.findtext('players') or ''})
    return games, by_sys

def pick(games, by_sys, system):
    if system:
        pool = games[system]
        return random.choice(pool) if pool else None
    systems = [s for s in games if games[s]]
    if not systems: return None
    total = sum(by_sys.values()) or 1
    # bigger collections come up more (square root, so small ones still get a turn); consoles you play up to 4x more
    weights = [(1 + 3 * by_sys.get(s, 0) / total) * math.sqrt(len(games[s])) for s in systems]
    s = random.choices(systems, weights)[0]
    return random.choice(games[s])

ui.background(); ui.header('SURPRISE ME', 'Picking a game...'); pygame.display.flip()
games, by_sys = load()
consoles = [None] + sorted((s for s in games if games[s]), key=lambda s: -by_sys.get(s, 0))
ci = 0
cur = pick(games, by_sys, None)
imgcache = {}
def art(path, box):
    if path not in imgcache:
        try:
            im = pygame.image.load(path).convert_alpha()
            imgcache[path] = im
        except Exception:
            imgcache[path] = None
    im = imgcache[path]
    if not im: return None
    s = min(box[0] / im.get_width(), box[1] / im.get_height())
    return pygame.transform.smoothscale(im, (int(im.get_width() * s), int(im.get_height() * s)))

inp = ui.Input(); clock = pygame.time.Clock()
while True:
    for a in inp.read():
        if a == 'b': sys.exit(0)
        if a in ('x', 'right', 'rb') : cur = pick(games, by_sys, consoles[ci])
        if a in ('up', 'down'):
            ci = (ci + (1 if a == 'down' else -1)) % len(consoles); cur = pick(games, by_sys, consoles[ci])
        if a in ('a', 'start') and cur:
            open(CHOICE, 'w').write(f"{cur['system']}\t{cur['rom']}"); sys.exit(0)
    ui.background()
    label = 'Any console' if consoles[ci] is None else NAMES.get(consoles[ci], consoles[ci])
    n = sum(len(v) for v in games.values()) if consoles[ci] is None else len(games[consoles[ci]])
    ui.header('SURPRISE ME', cur['name'] if cur else 'Nothing left to try!', f'{label}  -  {n} games you haven\'t played yet  (up/down: console)')
    if cur:
        box = (ui.px(820), ui.px(700))
        im = art(cur['image'], box)
        if im:
            r = im.get_rect(midtop=(ui.px(80) + box[0] // 2, ui.px(240)))
            ui.screen.blit(im, r)
        x = ui.px(960); y = ui.px(250); w = ui.W - x - ui.px(80)
        facts = [NAMES.get(cur['system'], cur['system'])] + [v for v in (cur['year'], cur['genre']) if v] + \
                ([f"{cur['players']} players"] if cur['players'] not in ('', '1') else [])
        ui.text('   ·   '.join(facts), 30, ui.ACCENT_LT, (x, y), maxw=w); y += ui.px(70)
        for line in ui.wrap(cur['desc'] or 'No description yet - give it a go!', 30, w)[:14]:
            ui.text(line, 30, (215, 225, 235), (x, y)); y += ui.px(44)
    ui.hints([('A', 'Play it'), ('X', 'Another one'), ('UP/DOWN', 'Console'), ('B', 'Back')])
    pygame.display.flip()
    if ui.SHOT:
        pygame.image.save(ui.screen, ui.SHOT); sys.exit(0)
    clock.tick(30)
