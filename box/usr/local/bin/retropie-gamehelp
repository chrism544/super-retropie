#!/usr/bin/env python3
"""Super RetroPie Game Help: where to go next in Zelda - A Link to the Past, read from your save.

  retropie-gamehelp            Game Help screen (RetroPie menu)
  retropie-gamehelp --text     print the same to the terminal

Uses the most recently played A Link to the Past save (.srm) in roms/snes, first valid slot.
Pages: Next step / Dungeons / Items.
"""
import glob, os, struct, sys, time

ROMS = os.path.expanduser('~/RetroPie/roms/snes')

def find_save():
    saves = [p for p in glob.glob(ROMS + '/**/*.srm', recursive=True) if 'Link to the Past' in p and 'Hack' not in p]
    for p in sorted(saves, key=os.path.getmtime, reverse=True):
        d = open(p, 'rb').read()
        for slot in range(3):
            b = d[slot * 0x500:(slot + 1) * 0x500]
            if len(b) == 0x500 and sum(struct.unpack('<640H', b)) & 0xffff == 0x5A5A:
                return p, slot + 1, b
    return None, 0, None

# (name, done(save), where to go, treasure)
STEPS = [
    ('Rescue Princess Zelda', lambda s: s[0x3C5] >= 2,
     'Head north to Hyrule Castle. Your uncle gives you a sword and shield in the secret passage by the castle wall. '
     'Find Zelda in the dungeon under the castle and lead her through the sewers to the Sanctuary.', 'Lamp, sword and shield'),
    ('Eastern Palace', lambda s: s[0x374] & 0x04,
     'Go east from Link\'s House, past Sahasrahla\'s hut, to the ruins in the far east. '
     'Light the dark rooms with the Lamp.', 'Bow, Pendant of Courage (green)'),
    ('Desert Palace', lambda s: s[0x374] & 0x02,
     'Sahasrahla gives you the Pegasus Boots. Dash (hold A) into the bookshelf in the Kakariko Library for the Book of Mudora. '
     'Then go to the Desert of Mystery in the south-west and read the Book at the stone tablet by the entrance.',
     'Power Glove, Pendant of Power (blue)'),
    ('Tower of Hera', lambda s: s[0x374] & 0x01,
     'Lift the rock north of Kakariko with the Power Glove and climb Death Mountain - the lost old man shows you the way '
     'and gives you the Magic Mirror. Take the warp tile into the Dark World, then use the Mirror to pop back out '
     'beside the tower.', 'Moon Pearl, Pendant of Wisdom (red)'),
    ('Master Sword', lambda s: s[0x359] >= 2,
     'With all three pendants, go to the Lost Woods in the north-west. The sword is on the pedestal in the clearing.',
     'Master Sword'),
    ('Agahnim (Hyrule Castle Tower)', lambda s: s[0x3C5] >= 3,
     'Back to Hyrule Castle. Cut the magic barrier at the top of the castle with the Master Sword and climb the tower. '
     'Hit Agahnim\'s energy balls back at him with your sword.', 'Sent to the Dark World'),
    ('Dungeon 1 - Palace of Darkness', lambda s: s[0x37A] & 0x02,
     'From the Pyramid go east, where the Eastern Palace is in the Light World. Kiki the monkey opens the door '
     'for 110 rupees.', 'Magic Hammer, crystal 1'),
    ('Dungeon 2 - Swamp Palace', lambda s: s[0x37A] & 0x10,
     'In the Dark World go south to the swamp. Use the Mirror to go to the Light World, enter the dam and pull the lever '
     'to drain the water, then go back through the warp - the palace is now open.', 'Hookshot, crystal 2'),
    ('Dungeon 3 - Skull Woods', lambda s: s[0x37A] & 0x40,
     'North-west of the Dark World, where the Lost Woods are. Drop through the holes and doors - the last part is '
     'reached from the far top-left.', 'Fire Rod, crystal 3'),
    ('Dungeon 4 - Thieves\' Town', lambda s: s[0x37A] & 0x20,
     'Walk south from Skull Woods into the Village of Outcasts. Pull the trident of the gargoyle statue in the middle '
     'of the village to open the entrance.', 'Titan\'s Mitt, crystal 4'),
    ('Dungeon 5 - Ice Palace', lambda s: s[0x37A] & 0x04,
     'Buy the Flippers from King Zora (north-east waterfall, 500 rupees). In the Light World swim to the small island '
     'in the east of Lake Hylia, lift the dark rock with the Titan\'s Mitt and take the warp. Melt the ice with the '
     'Fire Rod.', 'Blue Mail, crystal 5'),
    ('Dungeon 6 - Misery Mire', lambda s: s[0x37A] & 0x01,
     'Light World: play the Flute and fly to the desert (bottom-left). In the far bottom-left corner lift a dark rock '
     'with the Titan\'s Mitt and step on the warp. In the swamp, stand on the symbol in the middle and use the Ether '
     'medallion to open the entrance. Hookshot and Pegasus Boots get you over the gaps.', 'Cane of Somaria, crystal 6'),
    ('Dungeon 7 - Turtle Rock', lambda s: s[0x37A] & 0x08,
     'First get the Quake medallion: in the Dark World go to the Lake of Ill Omen (north-east) and throw a bush or rock '
     'into the ring of stones - the catfish gives you Quake. Then in the Light World climb to east Death Mountain, '
     'smash the pegs with the Hammer and take the warp at the top. Stand on the symbol and use Quake.',
     'Mirror Shield, crystal 7'),
    ('Ganon\'s Tower', lambda s: s[0x3C5] >= 4 or s[0x35B] >= 2,
     'With all 7 crystals, go to the top of Death Mountain in the Dark World (warp from Death Mountain, then climb). '
     'The seal on the tower breaks.', 'Red Mail, Agahnim again'),
    ('Ganon', lambda s: False,
     'Before the fight, get the Silver Arrows: buy the Super Bomb from the shop south of the Pyramid (100 rupees), '
     'lead it to the cracked wall on the Pyramid and throw your bow into the fairy\'s pond. Then beat Agahnim at the '
     'top of Ganon\'s Tower and follow Ganon to the Pyramid. Hit him with the sword, light the torches with the Fire '
     'Rod, then finish him with Silver Arrows.', 'The Triforce'),
]

ITEMS = [  # (name, have(save))
    ('Bow', lambda s: s[0x340] >= 1), ('Silver Arrows', lambda s: s[0x340] >= 3), ('Hookshot', lambda s: s[0x342]),
    ('Fire Rod', lambda s: s[0x345]), ('Ice Rod', lambda s: s[0x346]), ('Bombos', lambda s: s[0x347]),
    ('Ether', lambda s: s[0x348]), ('Quake', lambda s: s[0x349]), ('Lamp', lambda s: s[0x34A]),
    ('Magic Hammer', lambda s: s[0x34B]), ('Flute', lambda s: s[0x34C] >= 2), ('Book of Mudora', lambda s: s[0x34E]),
    ('Cane of Somaria', lambda s: s[0x350]), ('Cane of Byrna', lambda s: s[0x351]), ('Magic Cape', lambda s: s[0x352]),
    ('Magic Mirror', lambda s: s[0x353] >= 2), ('Power Glove', lambda s: s[0x354] >= 1), ('Titan\'s Mitt', lambda s: s[0x354] >= 2),
    ('Pegasus Boots', lambda s: s[0x355]), ('Flippers', lambda s: s[0x356]), ('Moon Pearl', lambda s: s[0x357]),
    ('Master Sword', lambda s: s[0x359] >= 2), ('Golden Sword', lambda s: s[0x359] >= 4),
    ('Mirror Shield', lambda s: s[0x35A] >= 3), ('Blue Mail', lambda s: s[0x35B] >= 1), ('Red Mail', lambda s: s[0x35B] >= 2),
]

path, slot, s = find_save()
if s:
    steps = [(n, bool(f(s)), w, t) for n, f, w, t in STEPS]
    nxt = next((x for x in steps if not x[1]), steps[-1])
    hearts = s[0x36C] // 8
    name = os.path.splitext(os.path.basename(path))[0]
    saved = time.strftime('%a %d %b %H:%M', time.localtime(os.path.getmtime(path)))

if '--text' in sys.argv:
    if not s: print('No A Link to the Past save found'); sys.exit(1)
    print(f'{name} slot {slot}, saved {saved}, {hearts} hearts\nNEXT: {nxt[0]}\n  {nxt[2]}\n  Treasure: {nxt[3]}')
    for n, done, _, _ in steps: print(('  [x] ' if done else '  [ ] ') + n)
    print('Missing:', ', '.join(n for n, f in ITEMS if not f(s)))
    sys.exit(0)

sys.path.insert(0, '/usr/local/lib/retropie')
import retropie_ui as ui
import pygame
if not s:
    ui.message('Game Help', 'No Zelda - A Link to the Past save found yet. Play it and save (Start, then Save and Continue) '
               'and Game Help will show where to go next.'); sys.exit(0)

inp = ui.Input(); page = 0
PAGES = ['Next step', 'Dungeons', 'Items']
clock = pygame.time.Clock()
while True:
    for a in inp.read():
        if a == 'b': sys.exit(0)
        if a in ('right', 'rb'): page = (page + 1) % len(PAGES)
        if a in ('left', 'lb'): page = (page - 1) % len(PAGES)
    ui.background()
    ui.header('GAME HELP', 'Zelda - A Link to the Past', '   '.join(('[ ' + p + ' ]') if i == page else p for i, p in enumerate(PAGES)))
    y = ui.px(240)
    if page == 0:
        done = sum(1 for x in steps if x[1])
        ui.text(f'Save slot {slot}  -  saved {saved}  -  {hearts} hearts  -  {done} of {len(steps)} goals done', 26, ui.DIM, (ui.px(80), y))
        y += ui.px(70)
        ui.text('NEXT', 28, ui.ACCENT_LT, (ui.px(80), y)); y += ui.px(40)
        ui.text(nxt[0], 50, ui.TEXT, (ui.px(80), y)); y += ui.px(90)
        for line in ui.wrap(nxt[2], 32, ui.W - ui.px(160)):
            ui.text(line, 32, (215, 225, 235), (ui.px(80), y)); y += ui.px(48)
        y += ui.px(30)
        ui.text('Treasure:  ' + nxt[3], 30, ui.GOOD, (ui.px(80), y))
    elif page == 1:
        col = len(steps) // 2 + 1
        for i, (n, done, _, _) in enumerate(steps):
            x = ui.px(80) if i < col else ui.W // 2 + ui.px(20)
            yy = y + (i % col) * ui.px(70)
            ui.text('✓' if done else '•', 34, ui.GOOD if done else (ui.ACCENT_LT if n == nxt[0] else ui.DIM), (x, yy - ui.px(4)))
            ui.text(n, 30, ui.TEXT if n == nxt[0] else (ui.DIM if done else (200, 210, 220)), (x + ui.px(50), yy), maxw=ui.W // 2 - ui.px(150))
    else:
        cols = 3; per = (len(ITEMS) + cols - 1) // cols
        for i, (n, f) in enumerate(ITEMS):
            have = bool(f(s))
            x = ui.px(80) + (i // per) * ui.px(600); yy = y + (i % per) * ui.px(70)
            ui.text('✓' if have else '–', 34, ui.GOOD if have else ui.BAD, (x, yy - ui.px(4)))
            ui.text(n, 30, ui.TEXT if have else ui.DIM, (x + ui.px(50), yy))
    ui.hints([('D-PAD', 'Pages'), ('B', 'Back')])
    pygame.display.flip()
    if ui.SHOT: pygame.image.save(ui.screen, ui.SHOT); sys.exit(0)
    clock.tick(30)
