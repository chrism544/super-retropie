#!/usr/bin/env python3
"""Controller battery level in the top-right corner of EmulationStation.

Runs as retropie-battery.service. Reads "Battery Percentage" of each connected Bluetooth controller
(bluetoothctl) once a minute. Shown only on the EmulationStation menu: hidden while a game or a
Super RetroPie menu screen is open (retropie-game-running) and when no controller reports a level.
The window is override-redirect, so it never takes keyboard/controller focus from EmulationStation.
Green above 50 %, amber 21-50 %, red 20 % and below (flashes at 10 % and below).
"""
import re, subprocess, time, tkinter as tk

POLL_BATTERY, POLL_STATE = 60, 2

def levels():
    out = []
    try:
        devs = subprocess.run(['bluetoothctl', 'devices', 'Connected'], capture_output=True, text=True, timeout=10).stdout
        for mac, name in re.findall(r'Device (\S+) (.+)', devs):
            info = subprocess.run(['bluetoothctl', 'info', mac], capture_output=True, text=True, timeout=10).stdout
            m = re.search(r'Battery Percentage: \S+ \((\d+)\)', info)
            if m and re.search(r'Icon: input-gaming|controller|gamepad|Xbox|Wireless Controller', info + name, re.I):
                out.append(int(m.group(1)))
    except Exception:
        pass
    return out

def screen_width():
    # Tk keeps the width it saw at start-up; ask X each time (the mode changes around games)
    try:
        out = subprocess.run(['xdpyinfo'], capture_output=True, text=True, timeout=5).stdout
        return int(re.search(r'dimensions:\s+(\d+)x', out).group(1))
    except Exception:
        return root.winfo_screenwidth()

def busy():
    return subprocess.run(['retropie-game-running']).returncode == 0

root = tk.Tk()
root.overrideredirect(True)
root.attributes('-topmost', True)
root.configure(bg='#0e1620')
lab = tk.Label(root, font=('DejaVu Sans', 18, 'bold'), bg='#0e1620', fg='#f7f7f7', padx=18, pady=6)
lab.pack()
state = {'levels': [], 'next': 0, 'shown': None, 'blink': False}

def tick():
    now = time.time()
    if now >= state['next']:
        state['levels'], state['next'] = levels(), now + POLL_BATTERY
    lv = state['levels']
    show = bool(lv) and not busy()
    if show:
        low = min(lv)
        colour = '#5ac878' if low > 50 else '#e6b450' if low > 20 else '#e66e6e'
        state['blink'] = not state['blink'] if low <= 10 else False
        txt = '   '.join(f'Controller  {v}%' for v in lv)
        lab.configure(text=txt, fg='#0e1620' if state['blink'] else colour)
        root.update_idletasks()
        w = root.winfo_reqwidth()
        if state['shown'] is not True or now >= state.get('wnext', 0):
            state['sw'], state['wnext'] = screen_width(), now + 30
        root.geometry(f'+{state["sw"] - w - 40}+30')
        if state['shown'] is not True: root.deiconify()
        root.lift()
    elif state['shown'] is not False:
        root.withdraw()
    state['shown'] = show
    root.after(POLL_STATE * 1000, tick)

root.withdraw(); state['shown'] = False
root.after(500, tick)
root.mainloop()
