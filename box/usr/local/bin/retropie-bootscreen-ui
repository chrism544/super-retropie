#!/usr/bin/env python3
"""Controller-friendly boot artwork and optional loading audio."""
import json, os, subprocess, sys
from pathlib import Path
sys.path.insert(0, '/usr/local/lib/retropie')
import retropie_ui as ui
import pygame
from retropie_boot_sound import CHOICES, resolve

SRC = Path('/usr/local/share/retropie-splash')
CONFIG = Path.home()/'.config/retropie-splash.json'
try:
    config = json.loads(CONFIG.read_text())
except (OSError, ValueError):
    config = {}
cur = config.get('style', 'super')
choices = [('super','Super RetroPie'),('consoles','Consoles'),('minimal','Minimal'),
           ('playstation','PlayStation'),('n64','Nintendo 64'),('gamecube','GameCube'),
           ('ps2','PlayStation 2'),('ps3','PlayStation 3'),('xbox','Xbox'),('wii','Wii'),('wiiu','Wii U'),('xbox360','Xbox 360'),('off','Off')]
choices = [(v,l) for v,l in choices if v == 'off' or (SRC/(v+'.png')).is_file()]
rows = [
    dict(label='Picture',value=cur,choices=choices,desc='Choose the picture shown during boot and while the game menu loads. Applied when you leave this screen. Existing pictures remain available.'),
    dict(label='Loading sound',value=config.get('sound','console') if config.get('sound','console') in dict(CHOICES) else ('console' if len(CHOICES) > 1 else 'off'),choices=CHOICES,desc='Match console plays the startup sound for the chosen picture. Standard N64 and general RetroPie pictures have no matching sound. You can also choose a console sound separately.'),
    dict(label='Volume',value=config.get('volume',50),choices=[(25,'25%'),(50,'50%'),(75,'75%'),(100,'100%')],desc='Loading-sound volume. Your normal game volume is unchanged.'),
    dict(label='Play sound',value=config.get('sound_when','startup'),choices=[('startup','Startup only'),('always','Every menu reload')],desc='Startup only plays once per reboot. Every menu reload also plays when EmulationStation restarts.'),
]
cache = {}
def preview(i,v):
    v = rows[0]['value']
    if v not in cache:
        s = pygame.Surface((ui.px(880),ui.px(495))); s.fill((0,0,0))
        if v != 'off':
            s = pygame.transform.smoothscale(pygame.image.load(str(SRC/(v+'.png'))).convert(),s.get_size())
        cache[v] = s
    return cache[v]
def save():
    config.update(style=rows[0]['value'],sound=rows[1]['value'],volume=rows[2]['value'],sound_when=rows[3]['value'])
    CONFIG.parent.mkdir(parents=True,exist_ok=True)
    tmp = CONFIG.with_suffix('.tmp'); tmp.write_text(json.dumps(config)+'\n'); tmp.replace(CONFIG)
def play():
    sound = rows[1]['value']
    path = resolve(sound, rows[0]['value'])
    if path is None:
        if len(CHOICES) == 1: return 'No startup sounds on this box yet. Run: sudo retropie-get-boot-sounds'
        return 'Sound is off.' if sound == 'off' else 'This picture has no console startup sound. Choose a console picture, or select a sound separately.'
    try:
        if not pygame.mixer.get_init(): pygame.mixer.init()
        pygame.mixer.stop()
        clip = pygame.mixer.Sound(str(path))
        clip.set_volume(rows[2]['value']/100); clip.play()
        return 'Playing preview through the current audio output.'
    except (pygame.error,OSError) as e:
        return 'Audio is unavailable: '+str(e)
rows.append(dict(label='Preview sound',action=play,desc='Listen to the selected console startup recording at your chosen volume. Match console follows the picture. N64 has no standard console startup sound.'))
def change(i,v):
    save()
    return 'Saved. Picture changes apply when you leave this screen.' if i == 0 else 'Saved.'
ui.options_screen('SETTINGS','Boot Screen',rows,change,preview)
pygame.mixer.stop() if pygame.mixer.get_init() else None
if rows[0]['value'] != cur:
    subprocess.Popen(['sudo','-n','systemd-run','--collect','--unit=retropie-bootscreen-apply','/usr/local/bin/retropie-bootscreen',rows[0]['value']],stdout=subprocess.DEVNULL,stderr=subprocess.DEVNULL)
