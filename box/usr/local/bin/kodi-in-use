#!/usr/bin/env python3
"""Is someone using Kodi right now? Check this before quitting, killing or restarting Kodi.
Oct 2026: Kodi was quit and then killed twice in 3 minutes during maintenance while someone was
on its Weather page. Exit 0 = in use (leave Kodi alone), 1 = free to restart, and prints why.
In use = something playing, or a button pressed in the last 15 minutes."""
import json, socket, subprocess, sys
if subprocess.run(["pgrep", "-x", "kodi.bin"], capture_output=True).returncode:
    print("free: Kodi is not running"); sys.exit(1)
def rpc(method, params=None):
    s = socket.create_connection(("127.0.0.1", 9090), 5)
    s.sendall(json.dumps({"jsonrpc": "2.0", "id": 1, "method": method, "params": params or {}}).encode())
    buf = b""
    while True:
        buf += s.recv(65536)
        try:
            r = json.loads(buf)
            if r.get("id") == 1:
                return r["result"]
            buf = b""                         # a notification - keep reading
        except ValueError:
            continue
try:
    if rpc("Player.GetActivePlayers"):
        print("in use: something is playing"); sys.exit(0)
    if not rpc("XBMC.GetInfoBooleans", {"booleans": ["System.IdleTime(900)"]})["System.IdleTime(900)"]:
        print("in use: a button was pressed in the last 15 minutes"); sys.exit(0)
except (OSError, KeyError) as e:
    print("in use: Kodi is running but not answering (%s) - starting or closing?" % e); sys.exit(0)
print("free: Kodi open but idle for 15+ minutes and nothing playing"); sys.exit(1)
