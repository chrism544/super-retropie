<button class="btn alt" onclick="reloadMenu()">Reload menu</button><div id="rmsg" class="msg"></div></div></div>
</main></section>
<script>
const $=id=>document.getElementById(id), esc=s=>String(s).replace(/[&<>"]/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[c]));
async function api(p,o={}){o.headers=Object.assign({'X-SRP':'1'},o.headers||{});const r=await fetch(p,o);
  if(r.status==401){show(false);throw new Error('pin')}const j=await r.json().catch(()=>({}));if(!r.ok)throw new Error(j.error||'Failed');return j}
function show(app){$('login').classList.toggle('hide',app);$('app').classList.toggle('hide',!app)}
async function login(){try{await api('/api/login',{method:'POST',body:JSON.stringify({pin:$('pin').value})});show(true);refresh()}catch(e){$('lmsg').textContent=e.message=='pin'?'Wrong PIN':e.message}}
function ago(t){const m=Math.round((Date.now()/1000-t)/60);return m<60?m+' min ago':m<1440?Math.round(m/60)+' h ago':Math.round(m/1440)+' days ago'}
function msg(id,text,ok){$(id).textContent=text;$(id).className='msg '+(ok?'ok':'err')}
async function refresh(){const s=await api('/api/status');
  $('now').textContent=s.now?s.now.name:(s.playing?'A game is running':'Game menu');
  $('nowsub').textContent=s.now?s.now.system+' · '+s.now.minutes+' min':'Nobody is playing right now';
  const cur=$('sys').value;$('sys').innerHTML='<option value="">Choose the console…</option>'+s.systems.map(([v,n])=>`<option value="${esc(v)}">${esc(n)}</option>`).join('');$('sys').value=cur;
  $('free').textContent=s.free_gb+' GB free on the box';
  document.querySelectorAll('[data-m]').forEach(b=>b.classList.toggle('on',b.dataset.m==s.uimode));
  const st=await api('/api/stats');$('wk').textContent=st.week_hours;$('tot').textContent=st.total_hours;$('gms').textContent=st.games;
  $('recent').innerHTML=st.recent.map(r=>`<div class="row"><span>${esc(r.name)}<br><small class="dim">${esc(r.system)} · ${r.minutes} min</small></span><small class="dim">${ago(r.end)}</small></div>`).join('')||'<span class="dim">Nothing yet</span>';
  $('top').innerHTML=st.top.map(r=>`<div class="row"><span>${esc(r.name)}<br><small class="dim">${esc(r.system)}</small></span><b>${r.hours} h</b></div>`).join('')||'<span class="dim">Nothing yet</span>';
  const l=await api('/api/imports');$('log').innerHTML=l.log.map(esc).join('<br>')||'Nothing imported yet'}
function put(f,sys){return new Promise((ok,bad)=>{const x=new XMLHttpRequest();x.open('PUT','/api/upload?system='+encodeURIComponent(sys)+'&name='+encodeURIComponent(f.name));
  x.setRequestHeader('X-SRP','1');x.upload.onprogress=e=>{$('prog').style.width=(e.loaded/e.total*100)+'%'};
  x.onload=()=>{let j={};try{j=JSON.parse(x.responseText)}catch(e){}x.status==200?ok(j):bad(new Error(j.error||'Upload failed'))};x.onerror=()=>bad(new Error('Connection lost'));x.send(f)})}
async function upload(){const sys=$('sys').value,fs=[...$('files').files];if(!sys)return msg('umsg','Choose the console first');if(!fs.length)return msg('umsg','Choose one or more files');
  for(const [i,f] of fs.entries()){msg('umsg',`Uploading ${i+1} of ${fs.length}: ${f.name}`,true);try{await put(f,sys)}catch(e){return msg('umsg',f.name+': '+e.message)}}
  msg('umsg',fs.length+' file(s) uploaded - they appear in the menu within a few minutes',true);$('files').value='';refresh()}
document.querySelectorAll('[data-m]').forEach(b=>b.onclick=async()=>{try{const r=await api('/api/kidmode',{method:'POST',body:JSON.stringify({mode:b.dataset.m})});msg('kmsg',r.message,true);setTimeout(refresh,4000)}catch(e){msg('kmsg',e.message)}});
async function reloadMenu(){try{msg('rmsg',(await api('/api/reload',{method:'POST'})).message,true)}catch(e){msg('rmsg',e.message)}}
document.querySelectorAll('nav button').forEach(b=>b.onclick=()=>{document.querySelectorAll('nav button').forEach(x=>x.classList.toggle('on',x==b));
  document.querySelectorAll('[data-p]').forEach(p=>p.classList.toggle('hide',p.dataset.p!=b.dataset.t))});
$('pin').addEventListener('keydown',e=>{if(e.key=='Enter')login()});
refresh().then(()=>show(true)).catch(()=>{});setInterval(()=>{if(!$('app').classList.contains('hide'))refresh().catch(()=>{})},15000);
</script></body></html>'''

if __name__ == '__main__':
    load_cfg()
    ThreadingHTTPServer.daemon_threads = True
    ThreadingHTTPServer(('', PORT), Handler).serve_forever()
