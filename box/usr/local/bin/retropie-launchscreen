#!/usr/bin/env python3
"""Super RetroPie launch screen. runcommand shows a 'launching' picture with feh; /usr/local/bin/feh
sends that call here. Shows a start-up screen in the style of the console being loaded (PlayStation's
white Sony screen then the black licence screen, the Xbox green glow, the Game Boy's falling
Nintendo logo...) with the game's name, until the game's own window is on screen.

- Keeps keyboard focus itself, so runcommand's black full-screen terminal can't come to the front
  (it did for 2-3 s before every game, Oct 2026). retropie-launchscreen-handoff closes this screen
  once the game window shows.
- A is passed on to runcommand's terminal, so it still opens RetroPie's launch menu.
- Y (read from the pad directly) asks for the game's manual: writes /tmp/retropie-manual-request,
  runcommand-onlaunch.sh shows it before the game starts.
- The first SIGINT (end of runcommand's picture delay) is ignored so the screen stays up while
  runcommand waits for the menu key.
- --daemon: started with the desktop, loads everything once and waits on /tmp/retropie-launchscreen.fifo.
  EmulationStation's game-start script writes "show<TAB><rom>" the moment a game is picked; the daemon
  forks a copy that draws the screen straight away (no black gap while runcommand starts). Its PID is
  in /tmp/retropie-launchscreen.pid; retropie-launchscreen-hide closes it. runcommand's own call (via
  feh) is then skipped. SIGUSR1 = the game is starting (A no longer opens the launch menu).
- LAUNCH_SHOT=<file.png> [LAUNCH_T=<seconds>] [LAUNCH_INFO=<file like /dev/shm/runcommand.info>] renders
  one frame to a file (for checking the look).
"""
import math, os, random, re, signal, subprocess, sys, time, xml.etree.ElementTree as ET
os.environ['SDL_JOYSTICK_ALLOW_BACKGROUND_EVENTS'] = '1'
os.environ.setdefault('PYGAME_HIDE_SUPPORT_PROMPT', '1')
import warnings; warnings.filterwarnings('ignore')

NAMES = {'arcade': 'Arcade', 'snes': 'Super Nintendo', 'nes': 'NES', 'megadrive': 'Mega Drive', 'n64': 'Nintendo 64',
         'psx': 'PlayStation', 'ps2': 'PlayStation 2', 'psp': 'PSP', 'gc': 'GameCube', 'wii': 'Wii', 'wiiu': 'Wii U',
         'nds': 'Nintendo DS', 'dreamcast': 'Dreamcast', 'gba': 'Game Boy Advance', 'gb': 'Game Boy', 'gbc': 'Game Boy Color',
         'mastersystem': 'Master System', 'gamegear': 'Game Gear', 'saturn': 'Saturn', 'xbox': 'Xbox'}
FIFO, PIDF = '/tmp/retropie-launchscreen.fifo', '/tmp/retropie-launchscreen.pid'
info = None
if sys.argv[1:2] == ['--daemon']:
    import pygame                                   # the slow part, done once
    signal.signal(signal.SIGCHLD, signal.SIG_IGN)   # finished screens reap themselves
    try: os.unlink(FIFO)
    except FileNotFoundError: pass
    os.mkfifo(FIFO, 0o600)
    def close_current():
        try:
            p = int(open(PIDF).read())
            if 'retropie-launchscreen' in open(f'/proc/{p}/cmdline').read(): os.kill(p, signal.SIGTERM)
        except Exception:
            pass
    while info is None:
        with open(FIFO) as f:
            for line in f:
                cmd, _, arg = line.rstrip('\n').partition('\t')
                if cmd == 'show' and arg.startswith(os.path.expanduser('~/RetroPie/roms/')):
                    close_current()
                    if os.fork() == 0:                    # the child draws this launch, then exits
                        signal.signal(signal.SIGCHLD, signal.SIG_DFL)
                        open(PIDF, 'w').write(str(os.getpid()))
                        info = [os.path.relpath(arg, os.path.expanduser('~/RetroPie/roms')).split('/')[0], '', arg]
                        break
                elif cmd == 'hide':
                    close_current()
    # child: black full screen at once, the rest is prepared while it fades in
    pygame.init()
    _s = pygame.display.set_mode((0, 0), pygame.FULLSCREEN); _s.fill((0, 0, 0)); pygame.display.flip()
    import atexit
    atexit.register(lambda: os.path.exists(PIDF) and open(PIDF).read() == str(os.getpid()) and os.unlink(PIDF))
try:
    system, emulator, rom = info or open(os.environ.get('LAUNCH_INFO', '/dev/shm/runcommand.info')).read().splitlines()[:3]
except Exception:
    os.execv('/usr/bin/feh', ['feh'] + sys.argv[1:])

base = os.path.expanduser(f'~/RetroPie/roms/{system}') + '/'
name, manual = os.path.splitext(os.path.basename(rom))[0], None
try:
    for g in ET.parse(base + 'gamelist.xml').getroot().iter('game'):
        p = g.findtext('path') or ''
        p = os.path.normpath(base + p[2:]) if p.startswith('./') else p
        if p == os.path.normpath(rom):
            name = g.findtext('name') or name
            if g.findtext('manual') and os.path.exists(g.findtext('manual')):
                manual = g.findtext('manual')
            break
except Exception:
    pass
stem = os.path.splitext(os.path.basename(rom))[0]
if not manual and os.path.exists(f'{base}media/manuals/{stem}.pdf'):
    manual = f'{base}media/manuals/{stem}.pdf'
name = re.sub(r'\s*[\(\[].*$', '', name) or name        # "Game (Europe) (En,Fr)" -> "Game"

sigints = [0]
def on_int(*_):
    sigints[0] += 1
    if sigints[0] >= 2: raise SystemExit(0)            # second one = A pressed for the launch menu
signal.signal(signal.SIGINT, on_int)
signal.signal(signal.SIGTERM, lambda *_: sys.exit(0))
launching = [False]
signal.signal(signal.SIGUSR1, lambda *_: launching.__setitem__(0, True))

import pygame
FONT = '/etc/emulationstation/themes/bluray/_inc/fonts/Roboto-Medium.ttf'
LOGOS = ['/etc/emulationstation/themes/carbon-2021/art/systems/{}.svg',
         '/etc/emulationstation/themes/art-book-next/_inc/systems/logos/{}.svg']
pygame.init()
SHOT = os.environ.get('LAUNCH_SHOT')
screen = pygame.display.set_mode((1920, 1080)) if SHOT else pygame.display.set_mode((0, 0), pygame.FULLSCREEN)
pygame.display.set_caption('Super RetroPie launching')
pygame.mouse.set_visible(False)
W, H = screen.get_size(); S = H / 1080; px = lambda v: int(v * S)
_fonts = {}
def font(n):
    if n not in _fonts:
        _fonts[n] = pygame.font.Font(FONT, px(n)) if os.path.exists(FONT) else pygame.font.SysFont('dejavusans', px(n))
    return _fonts[n]
def text(t, n, c, pos, anchor='center', alpha=255):
    s = font(n).render(t, True, c)
    if alpha < 255: s.set_alpha(int(alpha))
    r = s.get_rect(**{anchor: pos}); screen.blit(s, r); return r
def ease(t, start, dur):                     # 0 -> 1 between start and start + dur, smoothed
    x = min(1.0, max(0.0, (t - start) / dur)); return x * x * (3 - 2 * x)
_logos = {}
def logo(key, w, h, colour=None):
    """console logo (from the installed themes) fitted to w x h; colour = flat silhouette colour"""
    k = (key, w, h, colour)
    if k not in _logos:
        im = None
        for pat in LOGOS:
            try: im = pygame.image.load(pat.format(key)).convert_alpha(); break
            except Exception: pass
        if im:
            f = min(px(w) / im.get_width(), px(h) / im.get_height())
            im = pygame.transform.smoothscale(im, (int(im.get_width() * f), int(im.get_height() * f)))
            if colour:
                im = pygame.mask.from_surface(im).to_surface(setcolor=(*colour, 255), unsetcolor=(0, 0, 0, 0))
        _logos[k] = im
    return _logos[k]
def put(im, center, alpha=255):
    if not im: return None
    if alpha < 255: im = im.copy(); im.set_alpha(int(alpha))
    r = im.get_rect(center=center); screen.blit(im, r); return r
_glows = {}
def glow(colour, radius, center, alpha=255):
    k = (colour, radius)
    if k not in _glows:
        g = pygame.Surface((radius * 2, radius * 2), pygame.SRCALPHA)
        for i in range(radius, 0, -max(1, radius // 60)):
            a = int(110 * (1 - i / radius) ** 2)
            pygame.draw.circle(g, (*colour, a), (radius, radius), i)
        _glows[k] = g
    g = _glows[k].copy(); g.set_alpha(int(alpha)); screen.blit(g, g.get_rect(center=center))
def gradient(top, bottom):
    for y in range(0, H, 4):
        f = y / H
        pygame.draw.rect(screen, [int(a + (b - a) * f) for a, b in zip(top, bottom)], (0, y, W, 4))
CX, CY = W // 2, H // 2 - px(60)
random.seed(7)
CUBES = [(random.random(), random.random(), random.uniform(0.3, 1.0)) for _ in range(70)]

# ---- one start-up screen per console; each returns the text colour for the game name underneath ----
def boot_psx(t):
    if t < 2.2:                                      # Sony Computer Entertainment (white)
        screen.fill((255, 255, 255))
        a = 255 * ease(t, 0.1, 0.7) * (1 - ease(t, 1.8, 0.4))
        d = px(70); pts = [(CX, CY - d - px(60)), (CX + d, CY - px(60)), (CX, CY + d - px(60)), (CX - d, CY - px(60))]
        s = pygame.Surface((W, H), pygame.SRCALPHA)
        pygame.draw.polygon(s, (240, 130, 0, int(a)), pts)
        pygame.draw.polygon(s, (255, 200, 40, int(a)), [pts[0], pts[1], (CX, CY - px(60))])
        screen.blit(s, (0, 0))
        text('SONY', 64, (20, 20, 20), (CX, CY + px(80)), alpha=a)
        text('COMPUTER ENTERTAINMENT', 34, (20, 20, 20), (CX, CY + px(140)), alpha=a)
        return (120, 120, 120)
    screen.fill((0, 0, 0))                           # PlayStation licence screen (black)
    a = 255 * ease(t, 2.3, 0.8)
    put(logo('psx', 900, 260), (CX, CY), a)
    text('Licensed by', 30, (200, 200, 200), (CX, CY + px(190)), alpha=a)
    text('Sony Computer Entertainment Europe', 34, (200, 200, 200), (CX, CY + px(235)), alpha=a)
    return (170, 170, 170)

def boot_ps2(t):
    screen.fill((0, 0, 0))
    gradient((0, 0, 0), (0, 18, 60))
    for i, (x, h, sp) in enumerate(CUBES):           # the rising translucent "towers"
        hgt = int(px(500) * h * ease(t, 0.1 + i * 0.01, 1.5))
        col = pygame.Surface((px(22), max(1, hgt)), pygame.SRCALPHA)
        col.fill((90, 140, 255, int(40 + 50 * sp * (0.6 + 0.4 * math.sin(t * 2 + i)))))
        screen.blit(col, (int(x * W), H - hgt))
    a = 255 * ease(t, 1.2, 1.0)
    put(logo('ps2', 820, 300), (CX, CY), a)
    text('Sony Computer Entertainment', 30, (220, 225, 240), (CX, CY + px(200)), alpha=a)
    return (170, 185, 220)

def boot_psp(t):
    gradient((0, 0, 0), (10, 30, 70))
    for k in range(4):                               # the flowing XMB waves
        pts = [(x, H * 0.62 + px(70) * math.sin(x / px(260) + t * (0.8 + k * 0.25) + k) + k * px(18)) for x in range(0, W + 20, 20)]
        pygame.draw.aalines(screen, (120 + k * 30, 170 + k * 20, 255), False, pts)
    a = 255 * ease(t, 0.4, 1.0)
    put(logo('psp', 760, 260), (CX, CY - px(60)), a)
    text('Sony Computer Entertainment', 28, (200, 210, 230), (CX, CY + px(110)), alpha=a)
    return (160, 180, 210)

def boot_xbox(t):
    screen.fill((0, 0, 0))
    pulse = 0.75 + 0.25 * math.sin(t * 2.4)
    glow((60, 255, 60), px(560), (CX, CY), 255 * ease(t, 0, 1.2) * pulse)
    pygame.draw.circle(screen, (20, 120, 20), (CX, CY), px(150))
    pygame.draw.circle(screen, (110, 230, 60), (CX, CY), px(150), px(10))
    for sx in (-1, 1):                               # the X
        pygame.draw.line(screen, (190, 255, 120), (CX - sx * px(85), CY - px(85)), (CX + sx * px(85), CY + px(85)), px(26))
    a = 255 * ease(t, 0.8, 1.0)
    put(logo('xbox', 520, 140), (CX, CY + px(260)), a) or text('XBOX', 90, (140, 255, 90), (CX, CY + px(260)), alpha=a)
    text('Microsoft', 28, (170, 170, 170), (CX, CY + px(350)), alpha=a)
    return (150, 200, 140)

def boot_gc(t):
    gradient((70, 45, 150), (35, 20, 95))
    s = 1 - 0.15 * (1 - ease(t, 0, 1.2))             # the cube settles into place
    put(logo('gc', int(1000 * s), int(320 * s)), (CX, CY), 255 * ease(t, 0.1, 0.9))
    return (205, 195, 240)

def white_logo(key, w, h, sub=None):
    def f(t):
        screen.fill((255, 255, 255))
        a = 255 * ease(t, 0.2, 1.0)
        put(logo(key, w, h), (CX, CY), a)
        if sub: text(sub, 26, (120, 120, 120), (CX, CY + px(h // 2 + 70)), alpha=a)
        return (110, 110, 110)
    return f

def black_logo(key, w, h, sub=None, subcol=(200, 200, 200), colour=None):
    def f(t):
        screen.fill((0, 0, 0))
        a = 255 * ease(t, 0.2, 1.0)
        r = put(logo(key, w, h, colour), (CX, CY), a)
        if not r: text(NAMES.get(key, key).upper(), 90, (230, 230, 230), (CX, CY), alpha=a)
        if sub: text(sub, 28, subcol, (CX, CY + px(h // 2 + 80)), alpha=a)
        return (160, 160, 160)
    return f

def boot_sega(key, w=900, h=240):                    # Mega Drive TMSS-style licence screen
    return black_logo(key, w, h, 'PRODUCED BY OR UNDER LICENSE FROM SEGA ENTERPRISES LTD.')

def boot_dreamcast(t):
    screen.fill((255, 255, 255))
    a = 255 * ease(t, 0.2, 1.0)
    put(logo('dreamcast', 950, 220), (CX, CY), a)
    text('PRODUCED BY OR UNDER LICENSE FROM SEGA ENTERPRISES, LTD.', 24, (110, 110, 110), (CX, CY + px(190)), alpha=a)
    return (120, 120, 120)

def boot_saturn(t):
    screen.fill((0, 0, 0))
    glow((40, 90, 255), px(520), (CX, CY), 200 * ease(t, 0, 1.4))
    put(logo('saturn', 1000, 220), (CX, CY), 255 * ease(t, 0.5, 1.0))
    return (150, 165, 220)

def boot_gb(t):                                      # "Nintendo®" scrolls down onto the green screen
    screen.fill((155, 188, 15))
    y = CY - px(400) + px(400) * ease(t, 0, 1.8)
    text('Nintendo®', 96, (15, 56, 15), (CX, y))
    if t > 1.9: put(logo('gb', 700, 160, (48, 98, 48)), (CX, CY + px(170)), 255 * ease(t, 1.9, 0.6))
    return (48, 98, 48)

def boot_gbc(t):
    screen.fill((255, 255, 255))
    for i, c in enumerate([(230, 40, 40), (250, 200, 0), (40, 170, 60), (40, 90, 220)]):   # colour sweep
        x = int(W * ease(t, 0.15 * i, 0.9))
        pygame.draw.rect(screen, c, (W - x, CY + px(130) + i * px(10), x, px(8)))
    put(logo('gbc', 900, 220), (CX, CY - px(30)), 255 * ease(t, 0.5, 0.9))
    return (110, 110, 110)

def boot_neogeo(t):
    screen.fill((0, 0, 0))
    a = 255 * ease(t, 0.2, 1.0)
    put(logo('neogeo', 900, 260), (CX, CY - px(30)), a)
    text('MAX 330 MEGA', 56, (240, 200, 60), (CX, CY + px(150)), alpha=a)
    text('PRO-GEAR SPEC', 56, (240, 200, 60), (CX, CY + px(220)), alpha=a)
    return (200, 170, 80)

BOOT = {'psx': boot_psx, 'ps2': boot_ps2, 'psp': boot_psp, 'xbox': boot_xbox, 'gc': boot_gc,
        'wii': white_logo('wii', 700, 300), 'wiiu': white_logo('wiiu', 760, 260),
        'dreamcast': boot_dreamcast, 'saturn': boot_saturn,
        'megadrive': boot_sega('megadrive'), 'segacd': boot_sega('segacd'), 'sega32x': boot_sega('sega32x'),
        'mastersystem': boot_sega('mastersystem', 700, 300), 'sg-1000': boot_sega('sg-1000'),
        'gamegear': black_logo('gamegear', 900, 200),
        'n64': black_logo('n64', 1000, 200), 'snes': black_logo('snes', 1000, 260), 'nes': black_logo('nes', 900, 260),
        'fds': black_logo('fds', 900, 260),
        'gb': boot_gb, 'gbc': boot_gbc, 'gba': white_logo('gba', 1000, 160, 'Nintendo'), 'nds': white_logo('nds', 900, 220),
        'neogeo': boot_neogeo, 'arcade': black_logo('arcade', 900, 220), 'fba': black_logo('arcade', 900, 220),
        'mame-libretro': black_logo('arcade', 900, 220)}
boot = BOOT.get(system) or black_logo(system, 900, 260)

FADE = pygame.Surface((W, H)); FADE.fill((0, 0, 0))
def draw(t):
    c = boot(t)
    a = 255 * ease(t, 0.6, 0.8)
    n = name if font(40).size(name)[0] < W - px(200) else name[:60] + '…'
    text(n, 40, c, (CX, H - px(190)), alpha=a)
    text('Loading' + '.' * (int(t * 3) % 4), 26, c, (CX - font(26).size('Loading')[0] // 2, H - px(130)), 'midleft', alpha=a)
    hints = 'A  Launch options' + ('     Y  Read the manual' if manual else '')
    text(hints, 22, c, (px(60), H - px(50)), 'midleft', alpha=a * 0.8)
    if manual and os.path.exists('/tmp/retropie-manual-request'):
        text('The manual opens before the game starts', 26, c, (CX, H - px(250)))
    if t < 0.5:                                   # come up from black like a console switching on
        FADE.set_alpha(int(255 * (1 - ease(t, 0, 0.5)))); screen.blit(FADE, (0, 0))

if SHOT:
    draw(float(os.environ.get('LAUNCH_T', '3'))); pygame.image.save(screen, SHOT); sys.exit(0)

pygame.joystick.init()
pads = [pygame.joystick.Joystick(i) for i in range(pygame.joystick.get_count())]
draw(0); pygame.display.flip()
def x11(*cmd):
    try: subprocess.run(cmd, capture_output=True, timeout=3)
    except Exception: pass
# This screen keeps keyboard focus: runcommand's terminal is full-screen, and the window manager puts a
# focused full-screen window above everything - giving it focus showed 2-3 s of black terminal before
# every game (Oct 2026). A (pad, or the key joy2key sends) is passed on to the terminal for runcommand's
# launch menu instead.
def launch_menu():
    try:
        term = subprocess.run(['xdotool', 'search', '--class', 'xterm'], capture_output=True, text=True).stdout.split()
        if term:
            x11('xdotool', 'windowactivate', '--sync', term[-1]); x11('xdotool', 'key', 'Return')
    except Exception:
        pass
    raise SystemExit(0)
start = time.time()
clock = pygame.time.Clock()
while time.time() - start < 90:   # closed by retropie-launchscreen-handoff once the game shows
    for e in pygame.event.get():
        if e.type == pygame.JOYBUTTONDOWN and e.button == 3 and manual:
            open('/tmp/retropie-manual-request', 'w').write(manual)
        elif not launching[0] and (e.type == pygame.JOYBUTTONDOWN and e.button == 0) or (e.type == pygame.KEYDOWN and e.key in (pygame.K_RETURN, pygame.K_SPACE)):
            launch_menu()
    draw(time.time() - start); pygame.display.flip(); clock.tick(30)
