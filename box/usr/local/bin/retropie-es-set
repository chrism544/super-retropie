#!/usr/bin/env python3
"""Change EmulationStation settings safely from a tool launched by EmulationStation.

  retropie-es-set [--now] Key=type:value ...       e.g. ScreenSaverTime=int:300000 UIMode=string:Kid

ES keeps its settings in memory and could write the old ones back, so: wait until the calling
menu screen has closed (unless --now), hold the Openbox restart loop (/tmp/es-hold), kill -9 ES,
edit es_settings.cfg, release - ES comes straight back with the new settings.
Detaches itself, so the caller can exit immediately.
"""
import os, re, subprocess, sys, time

CFG = os.path.expanduser('~/.emulationstation/es_settings.cfg')

def edit(pairs):
    s = open(CFG).read()
    for key, tv in pairs:
        typ, val = tv.split(':', 1)
        tag = {'int': 'int', 'bool': 'bool', 'string': 'string', 'float': 'float'}[typ]
        line = f'<{tag} name="{key}" value="{val}" />'
        pat = re.compile(r'<\w+ name="' + re.escape(key) + r'" value="[^"]*" />')
        s = pat.sub(line, s) if pat.search(s) else s.replace('</config>', line + '\n</config>') if '</config>' in s else s + line + '\n'
    open(CFG, 'w').write(s)

pairs = [a.split('=', 1) for a in sys.argv[1:] if '=' in a and not a.startswith('--')]
if os.environ.get('ES_SET_CHILD') != '1':
    env = dict(os.environ, ES_SET_CHILD='1')
    subprocess.Popen([sys.executable, __file__] + sys.argv[1:], env=env, start_new_session=True,
                     stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    sys.exit(0)
if '--now' not in sys.argv:
    time.sleep(2.5)                                   # let the menu screen close and ES resume
open('/tmp/es-hold', 'w').close()
subprocess.run(['pkill', '-9', '-x', 'emulationstatio'])
time.sleep(1)
try:
    edit(pairs)
    for a in sys.argv[1:]:                            # --exec=<command>: also run while ES is stopped
        if a.startswith('--exec='):
            subprocess.run(a[7:], shell=True)
finally:
    os.remove('/tmp/es-hold')
