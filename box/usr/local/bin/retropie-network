#!/usr/bin/env python3
"""RetroPie menu > Network (replaces Show IP), in the EmulationStation (bluray) theme.

Pages (LB / RB, or left / right on the first two):
  Status    address, automatic/fixed, mask, gateway, DNS, link speed, MAC, internet + ping,
            file shares, Tailscale, streaming, Bluetooth, uptime
  Traffic   live download / upload speed with a 60-second graph, totals since start-up,
            internet speed test (Y)
  Settings  Automatic (DHCP) or Fixed address; address, mask, gateway and DNS edited with the
            D-pad. Apply asks "Keep these settings?" and undoes them by itself after 60 s
            (retropie-netcfg), so a wrong address can't lock the box off the network.
"""
import ipaddress, json, os, re, socket, subprocess, sys, threading, time, urllib.request
sys.path.insert(0, '/usr/local/lib/retropie')
import retropie_ui as ui
import pygame

def run(*cmd, timeout=4):
    try:
        return subprocess.run(cmd, capture_output=True, text=True, timeout=timeout).stdout
    except Exception:
        return ''

def iface():
    for line in run('ip', '-4', '-o', 'addr', 'show', 'scope', 'global').splitlines():
        m = re.match(r'\d+:\s+(\S+)\s+inet\s+([\d.]+)/(\d+)', line)
        if m and not m.group(1).startswith(('tailscale', 'docker', 'lo', 'veth', 'br-')):
            return m.group(1), m.group(2), int(m.group(3))
    for d in sorted(os.listdir('/sys/class/net')):
        if d.startswith(('en', 'eth', 'wl')): return d, None, None
    return None, None, None

def fmt_rate(bps):
    b = bps * 8
    return f'{b / 1e6:.1f} Mbit/s' if b >= 1e6 else f'{b / 1e3:.0f} kbit/s'

def fmt_bytes(n):
    for u in ('B', 'KB', 'MB', 'GB', 'TB'):
        if n < 1024 or u == 'TB': return f'{n:.0f} {u}' if u == 'B' else f'{n:.1f} {u}'
        n /= 1024

def netcfg(*args):
    r = subprocess.run(['sudo', '-n', '/usr/local/bin/retropie-netcfg', *args], capture_output=True, text=True, timeout=60)
    return (r.stdout or r.stderr).strip()

# ------------------------------------------------------------------ Status page data (refreshed every 5 s)
def status():
    dev, ip, prefix = iface()
    rows = []
    cfg = {}
    try: cfg = json.loads(netcfg('show'))
    except Exception: pass
    mode = 'Fixed address' if cfg.get('mode') == 'static' else 'Automatic (DHCP)'
    kind = 'Wired' if dev and dev.startswith(('en', 'eth')) else 'Wi-Fi'
    rows.append(('IP address', ip or 'Not connected', ui.ACCENT_LT if ip else ui.BAD, f'{mode}  -  {kind} ({dev})' if dev else ''))
    if ip:
        mask = str(ipaddress.ip_network(f'0.0.0.0/{prefix}').netmask)
        gw = re.search(r'default via ([\d.]+)', run('ip', 'route'))
        dns = re.findall(r'DNS Servers?: (.+)', run('resolvectl', 'status', dev)) or []
        rows.append(('Mask / gateway', f'{mask}   /   {gw.group(1) if gw else "none"}', ui.TEXT, ''))
        rows.append(('DNS', (dns[0].split()[0] if dns else ', '.join(cfg.get('dns', [])) or 'none'), ui.TEXT, ''))
    try:
        speed = int(open(f'/sys/class/net/{dev}/speed').read())
    except Exception:
        speed = 0
    mac = open(f'/sys/class/net/{dev}/address').read().strip() if dev else ''
    if dev and kind == 'Wi-Fi':
        sig = re.search(r'signal: (-?\d+)', run('iw', 'dev', dev, 'link')); ssid = re.search(r'SSID: (.+)', run('iw', 'dev', dev, 'link'))
        rows.append(('Wi-Fi', ssid.group(1) if ssid else 'not connected', ui.TEXT, f'signal {sig.group(1)} dBm' if sig else ''))
    elif speed > 0:
        rows.append(('Link speed', f'{speed} Mbit/s' if speed < 1000 else f'{speed // 1000} Gbit/s',
                     ui.GOOD if speed >= 1000 else (230, 180, 80),
                     'check the cable / switch port - this box can do 1 Gbit/s' if speed < 1000 else f'MAC {mac}'))
    t0 = time.time()
    try:
        socket.create_connection(('1.1.1.1', 53), timeout=3).close(); ping = (time.time() - t0) * 1000
    except OSError:
        ping = None
    rows.append(('Internet', 'Online' if ping is not None else 'Offline', ui.GOOD if ping is not None else ui.BAD,
                 f'{ping:.0f} ms to Cloudflare' if ping is not None else ''))
    pretty = run('hostnamectl', '--pretty').strip() or socket.gethostname()
    rows.append(('Name', pretty, ui.TEXT, f'{socket.gethostname()}.local'))
    if ip:
        rows.append(('File shares', f'\\\\{ip}\\roms', ui.TEXT, 'also  \\bios  and  \\drop'))
    ts = run('tailscale', 'status').strip()
    tsip = run('tailscale', 'ip', '-4').strip()
    rows.append(('Tailscale', tsip or ('Logged out' if 'Logged out' in ts else 'Off'), ui.TEXT if tsip else ui.DIM,
                 'remote access' if tsip else 'remote access is off'))
    devs = [l.split(' ', 2)[2] for l in run('bluetoothctl', 'devices', 'Connected').splitlines() if len(l.split(' ', 2)) == 3]
    rows.append(('Bluetooth', ', '.join(devs) if devs else 'Nothing connected', ui.TEXT if devs else ui.DIM, ''))
    up = float(open('/proc/uptime').read().split()[0])
    rows.append(('Running for', f'{int(up // 86400)} d {int(up % 86400 // 3600)} h' if up >= 86400 else f'{int(up // 3600)} h {int(up % 3600 // 60)} min', ui.DIM, ''))
    return rows, cfg, dev

# ------------------------------------------------------------------ speed test (background thread)
test = {'state': '', 'down': None, 'up': None, 'ping': None}
def speed_test():
    test.update(state='Testing latency...', down=None, up=None, ping=None)
    try:
        t = []
        for _ in range(4):
            t0 = time.time(); socket.create_connection(('1.1.1.1', 443), timeout=3).close(); t.append((time.time() - t0) * 1000)
        test['ping'] = min(t)
        test['state'] = 'Testing download...'
        t0 = time.time(); n = 0
        with urllib.request.urlopen('https://speed.cloudflare.com/__down?bytes=100000000', timeout=15) as r:
            while time.time() - t0 < 8:
                b = r.read(262144)
                if not b: break
                n += len(b)
        test['down'] = n / (time.time() - t0)
        test['state'] = 'Testing upload...'
        data = b'0' * 15_000_000
        t0 = time.time()
        urllib.request.urlopen(urllib.request.Request('https://speed.cloudflare.com/__up', data=data, method='POST'), timeout=30).read()
        test['up'] = len(data) / (time.time() - t0)
        test['state'] = 'done'
    except Exception as e:
        test['state'] = 'Speed test failed - is the internet connected?'

# ------------------------------------------------------------------ Settings page model
class Settings:
    def __init__(self, cfg, ip, prefix):
        addr = cfg.get('address') or (f'{ip}/{prefix}' if ip else '10.5.0.19/24')
        iface_ = ipaddress.ip_interface(addr)
        gw = cfg.get('gateway') or str(next(iface_.network.hosts()))
        dns = (cfg.get('dns') or [gw])[0]
        self.mode = cfg.get('mode', 'dhcp')
        self.ip = [int(x) for x in str(iface_.ip).split('.')]
        self.prefix = iface_.network.prefixlen
        self.gw = [int(x) for x in gw.split('.')]
        self.dns = [int(x) for x in dns.split('.')]
        self.sel, self.edit, self.octet, self.msg = 0, False, 0, ''
    ROWS = ['Address', 'IP address', 'Subnet mask', 'Gateway', 'DNS server', 'Apply changes']
    PREFIXES = [24, 16, 8, 25, 26, 27, 28, 23, 22, 20]
    def static(self): return self.mode == 'static'
    def value(self, i):
        if i == 0: return 'Fixed address' if self.static() else 'Automatic (DHCP)'
        if i == 1: return '.'.join(map(str, self.ip))
        if i == 2: return f'{ipaddress.ip_network(f"0.0.0.0/{self.prefix}").netmask}  (/{self.prefix})'
        if i == 3: return '.'.join(map(str, self.gw))
        if i == 4: return '.'.join(map(str, self.dns))
        return ''
    def octets(self, i): return {1: self.ip, 3: self.gw, 4: self.dns}.get(i)

def confirm_screen(inp, clock):
    end = time.time() + 45
    while True:
        left = int(end - time.time())
        if left <= 0:
            netcfg('revert'); return 'Settings undone (not confirmed in time).'
        for a in inp.read():
            if a == 'a': netcfg('confirm'); return 'New network settings kept.'
            if a == 'b': netcfg('revert'); return 'Settings undone - back to the previous address.'
        dev, ip, prefix = iface()
        ui.background(); ui.header('NETWORK', 'Keep these settings?')
        y = ui.px(260)
        ui.text(f'The box is now on:  {ip or "no address yet..."}', 40, ui.ACCENT_LT, (ui.px(80), y)); y += ui.px(90)
        for line in ui.wrap('If the picture, controller and internet still work, press A to keep the new settings. '
                            f'Otherwise press B - or just wait: they are undone by themselves in {left} seconds.', 32, ui.W - ui.px(160)):
            ui.text(line, 32, (215, 225, 235), (ui.px(80), y)); y += ui.px(48)
        ui.hints([('A', 'Keep'), ('B', 'Undo')]); pygame.display.flip(); clock.tick(30)

# ------------------------------------------------------------------ main loop
PAGES = ['Status', 'Traffic', 'Settings']
inp = ui.Input(); clock = pygame.time.Clock()
page = 0
rows, cfg, dev = status(); fetched = time.time()
_, ip0, prefix0 = iface()
st = Settings(cfg, ip0, prefix0)
hist = []                                            # (rx/s, tx/s) samples, 0.5 s apart
def counters(d):
    try:
        return int(open(f'/sys/class/net/{d}/statistics/rx_bytes').read()), int(open(f'/sys/class/net/{d}/statistics/tx_bytes').read())
    except Exception:
        return 0, 0
last = (time.time(), *counters(dev)); peak = [0, 0]

while True:
    for a in inp.read():
        if page == 2 and st.edit:                      # editing an IP: left/right = which number, up/down = change it
            o = st.octets(st.sel)
            if a in ('a', 'b'): st.edit = False
            elif a == 'left': st.octet = (st.octet - 1) % 4
            elif a == 'right': st.octet = (st.octet + 1) % 4
            elif a in ('up', 'down'): o[st.octet] = (o[st.octet] + (1 if a == 'up' else -1)) % 256
            elif a in ('rb', 'lb'): o[st.octet] = (o[st.octet] + (10 if a == 'rb' else -10)) % 256
            continue
        if a == 'b': sys.exit(0)
        if a in ('rb', 'right'): page = (page + 1) % 3; continue        # left/right always change page; A changes values
        if a in ('lb', 'left'): page = (page - 1) % 3; continue
        if page == 1 and a in ('y', 'a') and test['state'] in ('', 'done') or (page == 1 and a in ('y', 'a') and 'failed' in test['state']):
            threading.Thread(target=speed_test, daemon=True).start()
        if page == 2:
            if a == 'up': st.sel = (st.sel - 1) % len(st.ROWS); st.msg = ''
            elif a == 'down': st.sel = (st.sel + 1) % len(st.ROWS); st.msg = ''
            elif st.sel == 0 and a == 'a': st.mode = 'dhcp' if st.static() else 'static'
            elif st.sel == 2 and a == 'a' and st.static():
                i = st.PREFIXES.index(st.prefix) if st.prefix in st.PREFIXES else 0
                st.prefix = st.PREFIXES[(i + 1) % len(st.PREFIXES)]
            elif st.octets(st.sel) and a == 'a' and st.static(): st.edit, st.octet = True, 3
            elif st.sel == 5 and a == 'a':
                if st.static():
                    try:
                        itf = ipaddress.ip_interface(f'{st.value(1)}/{st.prefix}')
                        if ipaddress.ip_address(st.value(3)) not in itf.network: raise ValueError('The gateway must be on the same network as the IP address.')
                        if itf.ip in (itf.network.network_address, itf.network.broadcast_address): raise ValueError('That IP address can\'t be used on this network.')
                    except ValueError as e:
                        st.msg = str(e); continue
                    res = netcfg('apply', 'static', f'{st.value(1)}/{st.prefix}', st.value(3), st.value(4))
                else:
                    res = netcfg('apply', 'dhcp')
                if res.startswith('applied'):
                    time.sleep(3); st.msg = confirm_screen(inp, clock); rows, cfg, dev = status(); fetched = time.time()
                else:
                    st.msg = 'Could not apply: ' + res

    now = time.time()
    if now - last[0] >= 0.5:
        rx, tx = counters(dev)
        dt = now - last[0]
        r = (max(0, rx - last[1]) / dt, max(0, tx - last[2]) / dt)
        hist = (hist + [r])[-120:]; peak = [max(peak[0], r[0]), max(peak[1], r[1])]
        last = (now, rx, tx)
    if page == 0 and now - fetched > 5:
        rows, cfg, dev = status(); fetched = now

    ui.background()
    ui.header('RETROPIE', 'Network', '   '.join(('[ ' + p + ' ]') if i == page else p for i, p in enumerate(PAGES)))
    y = ui.px(230)
    if page == 0:
        panel = pygame.Rect(ui.px(80), y, ui.W - ui.px(160), ui.px(66) * len(rows) + ui.px(30))
        pygame.draw.rect(ui.screen, ui.PANEL, panel, border_radius=ui.px(22))
        pygame.draw.rect(ui.screen, ui.ACCENT, panel, width=ui.px(3), border_radius=ui.px(22))
        y = panel.y + ui.px(18)
        for i, (label, value, colour, note) in enumerate(rows):
            ui.text(label, 28, ui.DIM, (panel.x + ui.px(50), y + ui.px(8)))
            r = ui.text(value, 40 if i == 0 else 32, colour, (panel.x + ui.px(420), y + (0 if i == 0 else ui.px(4))))
            if note: ui.text(note, 24, ui.DIM, (r.right + ui.px(30), r.centery), 'midleft', maxw=panel.right - r.right - ui.px(80))
            y += ui.px(66)
        ui.hints([('D-PAD', 'Pages'), ('B', 'Back')])
    elif page == 1:
        cur = hist[-1] if hist else (0, 0)
        avg = [sum(h[k] for h in hist[-6:]) / max(1, len(hist[-6:])) for k in (0, 1)]
        for k, (label, col) in enumerate((('Download', ui.ACCENT_LT), ('Upload', ui.GOOD))):
            x = ui.px(80) + k * ui.px(560)
            ui.text(label, 30, ui.DIM, (x, y))
            ui.text(fmt_rate(avg[k]), 54, col, (x, y + ui.px(40)))
            ui.text(f'peak {fmt_rate(peak[k])}', 24, ui.DIM, (x, y + ui.px(112)))
        rx, tx = counters(dev)
        x = ui.px(1220)
        ui.text('Since start-up', 30, ui.DIM, (x, y))
        ui.text(f'Received  {fmt_bytes(rx)}', 36, ui.TEXT, (x, y + ui.px(44)))
        ui.text(f'Sent  {fmt_bytes(tx)}', 36, ui.TEXT, (x, y + ui.px(92)))
        # graph: last 60 s
        g = pygame.Rect(ui.px(80), y + ui.px(170), ui.W - ui.px(160), ui.px(330))
        pygame.draw.rect(ui.screen, ui.PANEL, g, border_radius=ui.px(16))
        top = max([max(h) for h in hist] + [125_000])
        for k, col in ((0, ui.ACCENT_LT), (1, ui.GOOD)):
            pts = [(g.right - ui.px(20) - (len(hist) - 1 - i) * (g.w - ui.px(40)) / 119,
                    g.bottom - ui.px(20) - h[k] / top * (g.h - ui.px(40))) for i, h in enumerate(hist)]
            if len(pts) > 1: pygame.draw.lines(ui.screen, col, False, pts, ui.px(4))
        ui.text(f'last 60 seconds  -  top of graph {fmt_rate(top)}', 22, ui.DIM, (g.x + ui.px(20), g.y + ui.px(12)))
        y = g.bottom + ui.px(30)
        ui.text('Internet speed test', 30, ui.ACCENT_LT, (ui.px(80), y)); y += ui.px(48)
        if test['state'] in ('', ):
            ui.text('Press Y to measure the internet speed (about 20 seconds, uses ~100 MB).', 28, ui.DIM, (ui.px(80), y))
        else:
            parts = []
            if test['ping'] is not None: parts.append(f'Ping {test["ping"]:.0f} ms')
            if test['down'] is not None: parts.append(f'Download {fmt_rate(test["down"])}')
            if test['up'] is not None: parts.append(f'Upload {fmt_rate(test["up"])}')
            ui.text('   ·   '.join(parts) if parts else '', 34, ui.TEXT, (ui.px(80), y))
            if test['state'] != 'done': ui.text(test['state'], 26, ui.BAD if 'failed' in test['state'] else ui.DIM, (ui.px(80), y + ui.px(52)))
        ui.hints([('D-PAD', 'Pages'), ('Y', 'Speed test'), ('B', 'Back')])
    else:
        for i, label in enumerate(st.ROWS):
            r = pygame.Rect(ui.px(80), y, ui.px(1000), ui.px(68))
            dim = 1 <= i <= 4 and not st.static()
            if i == st.sel: ui.pill(r, rad=ui.px(14))
            else: pygame.draw.rect(ui.screen, ui.PANEL, r, border_radius=ui.px(14))
            ui.text(label, 30, ui.DIM if dim else ui.TEXT, (r.x + ui.px(28), r.centery), 'midleft')
            o = st.octets(i)
            if o and st.edit and i == st.sel:
                xx = r.right - ui.px(28)
                for k in (3, 2, 1, 0):
                    rr = ui.text(str(o[k]), 30, (20, 20, 20) if k == st.octet else ui.TEXT, (xx, r.centery), 'midright')
                    if k == st.octet:
                        pygame.draw.rect(ui.screen, (247, 247, 247), rr.inflate(ui.px(16), ui.px(6)), border_radius=ui.px(6))
                        ui.text(str(o[k]), 30, (20, 20, 20), (xx, r.centery), 'midright')
                    xx = rr.left - ui.px(8)
                    if k: xx = ui.text('.', 30, ui.TEXT, (xx, r.centery), 'midright').left - ui.px(8)
            elif i < 5:
                ui.text(st.value(i), 28, ui.DIM if dim else (ui.TEXT if i == st.sel else ui.ACCENT_LT), (r.right - ui.px(28), r.centery), 'midright')
            y += ui.px(80) + (ui.px(20) if i == 4 else 0)
        dx = ui.px(1160); dw = ui.W - dx - ui.px(80); yy = ui.px(230)
        help_ = {0: 'Automatic: the router hands out the address (DHCP). Fixed: the box always uses the address below - '
                    'best for file shares, streaming and the nightly Proxmox backup, which all expect 10.5.0.19.',
                 1: 'The box\'s own address. Press A, then left/right to pick a number and up/down to change it (LB/RB = 10 at a time).',
                 2: 'Almost every home network uses 255.255.255.0.',
                 3: 'Your router\'s address - usually ending in .1.',
                 4: 'Name server - usually the router too, or 1.1.1.1.',
                 5: 'Switch to these settings. You get 45 seconds to check everything still works - if you don\'t confirm, '
                    'the old settings come back by themselves.'}[st.sel]
        if st.sel == 0 and not st.static():
            help_ += '  Note: with Automatic the address can change - the router once gave this box an address another device was using.'
        for line in ui.wrap(help_, 26, dw):
            ui.text(line, 26, (215, 225, 235), (dx, yy)); yy += ui.px(38)
        if st.msg:
            yy += ui.px(20)
            for line in ui.wrap(st.msg, 28, dw):
                ui.text(line, 28, ui.GOOD if 'kept' in st.msg else ui.BAD, (dx, yy)); yy += ui.px(40)
        ui.hints([('A', 'Done' if st.edit else 'Change'), ('D-PAD', 'Pages'), ('B', 'Back')])
    pygame.display.flip()
    if ui.SHOT:
        if os.environ.get('NET_PAGE'): page = int(os.environ['NET_PAGE']); ui.SHOT2 = ui.SHOT; ui.SHOT = None; continue
        pygame.image.save(ui.screen, ui.SHOT); sys.exit(0)
    if getattr(ui, 'SHOT2', None) and len(hist) > 6:
        pygame.image.save(ui.screen, ui.SHOT2); sys.exit(0)
    clock.tick(30)
