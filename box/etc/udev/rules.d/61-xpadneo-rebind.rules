ACTION=="add", SUBSYSTEM=="hid", ENV{MODALIAS}=="hid:b0005g*v0000045Ep00000B13", RUN+="/usr/local/bin/xpadneo-rebind %k"
ACTION=="add", SUBSYSTEM=="hid", ENV{MODALIAS}=="hid:b0005g*v0000045Ep00000B20", RUN+="/usr/local/bin/xpadneo-rebind %k"
ACTION=="add", SUBSYSTEM=="hid", ENV{MODALIAS}=="hid:b0005g*v0000045Ep00000B22", RUN+="/usr/local/bin/xpadneo-rebind %k"
