# Xbox Bluetooth pads -> xpadneo (hid-microsoft grabs them first otherwise)
ACTION=="add", SUBSYSTEM=="hid", ENV{MODALIAS}=="hid:b0005g*v0000045Ep000002E0", RUN+="/usr/local/bin/xpadneo-rebind %k"
