#!/bin/bash
# While a game runs, pause heavy background jobs (7z / chdman / Skyscraper) and resume them after.
# The box is a 35 W processor: a full-speed unpack takes power the game needs (Xbox crawled, Oct 2026).
PAT="[7]z (x|e) |[c]hdman |[S]kyscraper "
while true; do
    if retropie-game-running; then
        pkill -STOP -f -E "$PAT" 2>/dev/null; touch /run/retropie-bg-paused
    elif [ -e /run/retropie-bg-paused ]; then
        pkill -CONT -f -E "$PAT" 2>/dev/null; rm -f /run/retropie-bg-paused
    fi
    sleep 5
done
