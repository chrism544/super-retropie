#!/bin/bash
# Closes the launch screen once the game's own window is on screen, instead of the moment the
# emulator starts - otherwise runcommand's black terminal shows for the 1-3 s the emulator takes
# to open its window (seen as a flicker between the launch screen and the game, Oct 2026).
# Started in the background by runcommand-onlaunch.sh. Gives up after 20 s (runcommand-onend.sh
# also closes the launch screen when the game ends).
export DISPLAY=${DISPLAY:-:0}
showing() {
    local p; p=$(cat /tmp/retropie-launchscreen.pid 2>/dev/null)
    { [ -n "$p" ] && grep -q retropie-launchscreen /proc/$p/cmdline 2>/dev/null; } ||
        pgrep -f "^python3 /usr/local/bin/retropie-launchscreen -F" >/dev/null
}
# tell the daemon's screen the game is starting (A no longer opens the launch menu)
p=$(cat /tmp/retropie-launchscreen.pid 2>/dev/null); [ -n "$p" ] && kill -USR1 "$p" 2>/dev/null
for _ in $(seq 200); do
    showing || exit 0
    w=$(xprop -root _NET_ACTIVE_WINDOW 2>/dev/null | awk '{print $NF}')
    if [ -n "$w" ] && [ "$w" != "0x0" ]; then
        case "$(xprop -id "$w" WM_CLASS 2>/dev/null)" in
            *XTerm*|*retropie-launchscreen*|*emulationstation*|"") ;;
            *) sleep 0.4; break ;;   # the game's window is up; give it a moment to draw its first frame
        esac
    fi
    sleep 0.1
done
/usr/local/bin/retropie-launchscreen-hide
