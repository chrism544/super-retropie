#!/usr/bin/env python3
"""Game Settings > Advanced > Game launch logs.

runcommand-onend.sh keeps a copy of runcommand's log for every launch in
~/.local/share/retropie-launch-logs/ (header: system, emulator, rom, ended, then the log). The list
shows the newest first with the likely problem lines; A opens the whole log (up/down scrolls,
LB/RB a page).
"""
import glob, os, re, sys, time
sys.path.insert(0, '/usr/local/lib/retropie')
import retropie_ui as ui
import pygame

DIR = os.path.expanduser('~/.local/share/retropie-launch-logs')
PROBLEM = re.compile(r'error|fail|fatal|not found|missing|unable|cannot|can\'t|denied|segmentation|abort|invalid|no such', re.I)
NOISE = re.compile(r'avx2|pygame|bootstrap|iCCP|client\.conf|Wayland|cloud sync', re.I)

def load(path):
    head, body = {}, []
    lines = open(path, errors='replace').read().splitlines()
    if '---' in lines:
        i = lines.index('---')
        for l in lines[:i]:
            k, _, v = l.partition('='); head[k] = v
        body = lines[i + 1:]
    else:
        body = lines
    return head, body

def summary(head, body):
    probs = [l.strip() for l in body if PROBLEM.search(l) and not NOISE.search(l)]
    rom = head.get('rom', '')
    lines = [f"{head.get('system', '?')}  -  {head.get('emulator', '?')}", os.path.basename(rom), '']
    if probs:
        lines += ['Possible problems:'] + [p[:160] for p in probs[-6:]]
    else:
        lines += ['No error messages.', 'Last lines:'] + [l[:160] for l in body[-5:] if l.strip()]
    return '\n'.join(lines), bool(probs)

def viewer(title, body):
    inp = ui.Input(); top = 0
    lines = []
    for l in body:
        lines += ui.wrap(l, 24, ui.W - ui.px(160)) or ['']
    per = (ui.H - ui.px(220) - ui.px(110)) // ui.px(32)
    clock = pygame.time.Clock()
    while True:
        for a in inp.read():
            if a == 'b' or a == 'a': return
            if a == 'down': top += 1
            if a == 'up': top -= 1
            if a in ('rb', 'right'): top += per
            if a in ('lb', 'left'): top -= per
        top = max(0, min(top, max(0, len(lines) - per)))
        ui.background(); ui.header('GAME LAUNCH LOG', title, f'lines {top + 1}-{min(len(lines), top + per)} of {len(lines)}')
        y = ui.px(220)
        for l in lines[top:top + per]:
            c = ui.BAD if PROBLEM.search(l) and not NOISE.search(l) else (215, 225, 235)
            ui.text(l, 24, c, (ui.px(80), y)); y += ui.px(32)
        ui.hints([('UP/DOWN', 'Scroll'), ('LB/RB', 'Page'), ('B', 'Back')])
        pygame.display.flip()
        if ui.SHOT: pygame.image.save(ui.screen, ui.SHOT); sys.exit(0)
        clock.tick(60)

files = sorted(glob.glob(DIR + '/*.log'), reverse=True)
if not files:
    ui.message('Game launch logs', 'No game launches have been logged yet. Every game you start from now on is listed here.')
    sys.exit(0)
rows = []
for f in files:
    head, body = load(f)
    when = time.strftime('%d %b %H:%M', time.localtime(os.path.getmtime(f)))
    name = re.sub(r'\s*[\(\[].*$', '', os.path.splitext(os.path.basename(head.get('rom', '')))[0]) or '?'
    desc, bad = summary(head, body)
    rows.append({'label': f"{'! ' if bad else ''}{when}  {name}", 'desc': desc,
                 'action': (lambda n=name, b=body: viewer(n, b))})
ui.options_screen('SETTINGS', 'Game launch logs', rows, sub='Newest first. ! = error messages found. A: read the whole log')
