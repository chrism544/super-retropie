#!/usr/bin/env python3
"""xemu-set-scale <in.toml> <out.toml> <scale> [renderer]: copy xemu settings with
[display.quality] surface_scale (and optionally [display] renderer = OPENGL/VULKAN) set.
xemu rewrites its settings on start/exit and leaves out values at their default, so a
section or key may be missing."""
import re, sys
src, dst, n = sys.argv[1], sys.argv[2], sys.argv[3]
rend = sys.argv[4].upper() if len(sys.argv) > 4 and sys.argv[4] else None

def put(t, section, key, val):
    if re.search(rf"(?m)^{key}\s*=", t):
        return re.sub(rf"(?m)^{key}\s*=.*$", f"{key} = {val}", t)
    if re.search(rf"(?m)^\[{re.escape(section)}\]\s*$", t):
        return re.sub(rf"(?m)^\[{re.escape(section)}\]\s*$", f"[{section}]\n{key} = {val}", t, count=1)
    return t.rstrip("\n") + f"\n\n[{section}]\n{key} = {val}\n"

t = open(src).read()
t = put(t, "display.quality", "surface_scale", n)
if rend:
    t = put(t, "display", "renderer", f"'{rend}'")
open(dst, "w").write(t)
